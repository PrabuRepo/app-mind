# Copy this file to .env and fill in real values. Never commit .env itself.
# Windows (PowerShell): Copy-Item .env.example .env
# macOS/Linux: cp .env.example .env

# LLM / embeddings
OPENAI_API_KEY=sk-...

# GitHub MCP (real-code citations for incident_rca questions) — a
# fine-grained, read-only PAT scoped to Contents on your target repo only.
# See docs/documentation.md §3 for why this is scoped this way.
GITHUB_TOKEN=github_pat_...
GITHUB_TARGET_REPO=owner/repo-name

# Postgres (matches docker-compose.yml defaults — leave as-is unless you
# changed the compose file)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=appmind
POSTGRES_USER=appmind
POSTGRES_PASSWORD=appmind

# Qdrant
QDRANT_URL=http://localhost:6333

# Redis
REDIS_URL=redis://localhost:6379/0
